<!-- ==================================================================================
     页脚 · 本页更新时间（时间由 build.mjs 按 workflow 的 cron 计算）
     ================================================================================== -->
<local:MyCard Title="页面信息" CanSwap="False">
    <StackPanel Margin="25,40,23,15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：两个时间 -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,7" FontSize="12"
                           Foreground="{DynamicResource ColorBrush3}" Text="数据更新于" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,7" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource ColorBrush1}" Text="2026-10-29 08:02" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" FontSize="12"
                           Foreground="{DynamicResource ColorBrush3}" Text="下次自动更新" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource ColorBrush1}" Text="2026-10-30 04:17" />
            </Grid>

            <!-- 右：刷新按钮 -->
            <local:MyButton Grid.Column="1" VerticalAlignment="Center" Height="34" Padding="18,0,18,0"
                            ColorType="Highlight" Text="刷新页面" EventType="刷新页面"
                            ToolTip="重新加载当前主页内容" />
        </Grid>
    </StackPanel>
</local:MyCard>


<!-- ==================================================================================
     常用属性速查（写新卡片时对照着抄）
     ==================================================================================
     通用：Width / Height / Margin（左,上,右,下）/ ToolTip / HorizontalAlignment
           (Left|Center|Right|Stretch) / VerticalAlignment / IsHitTestVisible
     文本 TextBlock：Text、TextWrapping="Wrap"、FontSize、FontWeight="Bold"、Foreground
     图片 MyImage：Source（网址或 pack:// 内置路径）、FallbackSource、EnableCache
     卡片 MyCard：Title、CanSwap、IsSwapped、UseAnimation、SwapLogoRight、HasMouseAnimation
     提示条 MyHint：Text、Theme（Blue | Yellow | Red）
     按钮 MyButton：Text、Padding、ColorType（Highlight | Red | 默认黑）、EventType、EventData
     文本按钮 MyTextButton：Text、EventType、EventData
     列表项 MyListItem：Logo、Title、Info、Type（Clickable 才能点）
     图标按钮 MyIconTextButton：Text、Logo（SVG Path）、LogoScale、ColorType
     图标按钮 MyIconButton：Logo、LogoScale、Theme（Color | White | Black | Red）
     主题色：{DynamicResource ColorBrush1} ~ {DynamicResource ColorBrush8}（1 最深，8 最浅）

     事件类型速查：
       打开网页、打开文件、打开帮助、启动游戏、复制文本、下载文件、
       弹出窗口、内存优化、清理垃圾、修改变量、刷新页面
       - 启动游戏 EventData："版本|地址"
       - 弹出窗口 EventData："标题|内容"
       - 修改变量 EventData："变量名|值|-"

     注意：XML 注释内不能出现连续两个连字符，否则 PCL 解析失败白屏。
     ================================================================================== -->
