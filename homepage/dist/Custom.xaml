<!-- ==================================================================================
     PCL 主页模板（首页骨架）
     ==================================================================================
     这个文件是「模板」，不是 PCL 实际读取的文件。
     homepage/build.mjs 会把 @@xxx@@ 占位符替换成接口取回的真实数据，
     再输出到：
       - ../Custom.xaml          PCL 本地主页（直接生效）
       - ./dist/Custom.xaml      联网主页用（上传到任意静态托管）

     所以：改样式、改卡片内容，都改这个文件，别改生成的 Custom.xaml。
     改完执行：node homepage/build.mjs
     ================================================================================== -->


<!-- ==================================================================================
     卡片 1 · 内存优化
     ================================================================================== -->
<local:MyCard Title="内存优化" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"
                   Foreground="{DynamicResource ColorBrush3}"
                   Text="启动大型整合包前先跑一遍，能明显减少卡顿与内存溢出。两个操作互不影响，按需点击。" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyButton Grid.Column="0" Margin="0,0,8,0" Height="40" ColorType="Highlight"
                            Text="一键内存优化" EventType="内存优化"
                            ToolTip="释放被其他程序占用的闲置内存，不会影响正在运行的游戏" />
            <local:MyButton Grid.Column="1" Margin="8,0,0,0" Height="40"
                            Text="清理垃圾文件" EventType="清理垃圾"
                            ToolTip="删除 PCL 的日志与缓存文件，不会删除游戏本体和存档" />
        </Grid>

        <local:MyHint Margin="0,12,0,0" Theme="Yellow"
                      Text="内存优化：把系统里闲置的物理内存还给可用池，适合开游戏前点一下。&#xA;清理垃圾：清掉启动器产生的缓存和日志，占空间大了再点，别频繁点。" />
    </StackPanel>
</local:MyCard>


